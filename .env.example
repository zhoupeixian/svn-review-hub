# 站点自动同步配置。配置文件可放在任意位置，通过 --config 或 REVIEW_PORTAL_CONFIG 指定。
# 本地原始审查日志保留绝对路径；上传前按 REVIEW_PROJECT_ROOT 转换为相对路径。
REVIEW_PORTAL_URL=https://your-review-portal.example
REVIEW_PORTAL_PROJECT_SLUG=zherp
REVIEW_PROJECT_ROOT=replace-with-absolute-svn-working-copy-root
REVIEW_PORTAL_SYNC_KEY=replace-with-a-long-random-secret
REVIEW_PORTAL_DISPATCH_TOKEN=private-site-service-token
REVIEW_LOG_ROOT=replace-with-absolute-review-log-root
