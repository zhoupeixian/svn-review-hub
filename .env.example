# 站点自动同步配置。实际值请写入 .env 或
# C:\Users\31487\.codex\automations\zherp\review-portal.env，勿提交密钥。
REVIEW_PORTAL_URL=https://your-review-portal.example
REVIEW_PORTAL_PROJECT_SLUG=zherp
REVIEW_PORTAL_SYNC_KEY=replace-with-a-long-random-secret
REVIEW_PORTAL_DISPATCH_TOKEN=private-site-service-token
REVIEW_LOG_ROOT=D:\SVN\ZHERP\automation-output\svn审查

# 站点服务端匿名来源摘要密钥。部署环境中也必须配置，至少 32 个随机字符。
ANONYMOUS_SOURCE_HASH_KEY=replace-with-at-least-32-random-characters
